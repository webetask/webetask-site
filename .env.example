# Copy this file to .env.local on the server and fill in the values.
# Never commit .env.local to GitHub.

# Public site address (used for SEO links). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://webetask.app

# Supabase: where contact form messages are saved.
# Supabase dashboard > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use the anon (public) key. The table only allows inserts (see supabase/contact_messages.sql),
# so this key cannot read anything back. Do NOT put the service_role key here.
SUPABASE_ANON_KEY=

# Email: where contact form messages are sent (your Mailcow server or any SMTP provider)
SMTP_HOST=mail.webetask.app
# 465 = SSL, 587 = STARTTLS
SMTP_PORT=465
SMTP_USER=support@webetask.app
SMTP_PASS=
# The "from" address on the notification email
SMTP_FROM=Webetask website <support@webetask.app>
# Inbox that receives the messages
CONTACT_TO=support@webetask.app
